{
  "name": "groundstation",
  "version": "0.1.0",
  "description": "Mission control for a small cloud fleet — a terminal command center over gcloud + Ansible.",
  "type": "module",
  "bin": {
    "gnd": "./src/index.tsx"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "DEV=true bun run src/index.tsx",
    "typecheck": "tsc --noEmit",
    "compile": "bun build --compile ./src/index.tsx --outfile gnd",
    "test": "bun test"
  },
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "@opentui/react": "^0.4.5",
    "@opentui/keymap": "^0.4.5",
    "@opentui/qrcode": "^0.4.5",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
